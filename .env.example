MONGODB_URI=

APP_BASE_URL=

# Create a long random value and configure the same Bearer credential in Vapi.
VAPI_WEBHOOK_SECRET=

CUSTOMER_OTP_SECRET=

# Optional operational configuration.
BARBERSHOP_TIME_ZONE=
VAPI_STORE_TRANSCRIPTS=

# Setup references only. Keep these server-side and never prefix them with NEXT_PUBLIC_.
VAPI_PRIVATE_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Recommended for production Twilio API authentication.
TWILIO_API_KEY=
TWILIO_API_KEY_SECRET=

# Recommended sender configuration for A2P registration and opt-out management.
TWILIO_MESSAGING_SERVICE_SID=

# Call POST /api/cron/appointment-reminders every 10-15 minutes with this Bearer token.
CRON_SECRET=
TWILIO_REMINDER_HOURS_BEFORE=
TWILIO_REMINDER_WINDOW_MINUTES=